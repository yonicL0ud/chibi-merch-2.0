{
  "name": "Chibi Merch - Laravel + MySQL",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Laravel", "onAutoForward": "notify" } },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "onecentlab.laravel-blade-snippets",
        "mikestead.dotenv"
      ]
    }
  }
}
